# Copy to /etc/hill175/hill175.env (root:root, mode 0600), then fill in Hill IT values.
# This file uses a restricted systemd EnvironmentFile format: KEY=value or KEY='value'.
# No export, interpolation, escapes, inline comments, or multiline values.
HILL175_AUTH_MODE=microsoft
HILL175_ENTRA_TENANT_ID=replace-with-hill-tenant-guid
HILL175_ENTRA_CLIENT_ID=replace-with-application-client-guid
HILL175_ENTRA_CLIENT_SECRET='replace-with-client-secret-value'
HILL175_ENTRA_REQUIRED_ROLE=Hill175.Student
HILL175_ENTRA_STAFF_ROLE=Hill175.Staff
HILL175_ENTRA_MODERATOR_ROLE=Hill175.Moderator
HILL175_ENTRA_ADMINISTRATOR_ROLE=Hill175.Administrator
HILL175_AUTH_PUBLIC_URL=https://auth.example.org
HILL175_AUTH_PORT=8087
HILL175_MAX_LINKED_ACCOUNTS=4
# Optional private bootstrap digest. If absent, the server creates a private runtime key.
# HILL175_ADMIN_UNLOCK_SHA256=replace-with-sha256-of-a-generated-43-character-key

# Optional deployment settings. Place the certificates/key at these paths once;
# nginx configuration and Cloudflare source restrictions are generated automatically.
HILL175_ORIGIN_CERT=/etc/hill175/tls/origin.pem
HILL175_ORIGIN_KEY=/etc/hill175/tls/origin.key
HILL175_AOP_CA=/etc/hill175/tls/aop-ca.pem
HILL175_BEDROCK_ENABLED=true
HILL175_BEDROCK_PORT=19132
# Current Bedrock connects to the HTTPS hostname on port 443. The base port is
# local TCP signaling and legacy RakNet UDP; the following UDP port is WebRTC.
# Configure proxied Cloudflare DNS, Full (strict), and Authenticated Origin Pulls.
# HILL175_BEDROCK_PUBLIC_URL=https://bedrock.example.org
# HILL175_GALLERY_PUBLIC_URL=https://builds.example.org
# HILL175_STUDENT_DOWNLOAD_EXPORT=/opt/hill175-exports/student-campus
# HILL175_STUDENT_DOWNLOAD_URL=https://builds.example.org/student-map/
# HILL175_STUDENT_DOWNLOAD_PORT=8791
# HILL175_PACKET_REPLAY_ENABLED=true
# HILL175_SURVIVAL_MODE=transfer
# HILL175_SURVIVAL_JAVA_HOST=survival.example.org
# HILL175_SURVIVAL_JAVA_PORT=25567
# HILL175_SURVIVAL_DESTINATION_ACCESS_CONFIGURED=true
# HILL175_SURVIVAL_BEDROCK_LOCAL=true
# Optional loopback TLS backend for an existing local nginx stream proxy.
# The stream proxy must send PROXY protocol and route these hostnames here.
# HILL175_NGINX_PROXY_PROTOCOL_PORT=8444
# Optional comma-separated proxy peer CIDRs allowed to reach nginx. The keyword
# cloudflare adds Cloudflare's published ranges; unset means cloudflare only.
# HILL175_TRUSTED_PROXY_RANGES=cloudflare,203.0.113.0/24,2001:db8::/48
