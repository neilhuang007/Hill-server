# Copy to /etc/hill175/hill175.env (root:root, mode 0600), then fill in Hill IT values.
# This file uses a restricted systemd EnvironmentFile format: KEY=value or KEY='value'.
# No export, interpolation, escapes, inline comments, or multiline values.
HILL175_AUTH_MODE=microsoft
HILL175_ENTRA_TENANT_ID=replace-with-hill-tenant-guid
HILL175_ENTRA_CLIENT_ID=replace-with-application-client-guid
HILL175_ENTRA_CLIENT_SECRET='replace-with-client-secret-value'
HILL175_ENTRA_REQUIRED_ROLE=Hill175.Student
HILL175_AUTH_PUBLIC_URL=https://auth.example.org
HILL175_AUTH_PORT=8087
HILL175_MAX_LINKED_ACCOUNTS=4

# Optional deployment settings. Place the certificates/key at these paths once;
# nginx configuration and Cloudflare source restrictions are generated automatically.
HILL175_ORIGIN_CERT=/etc/hill175/tls/origin.pem
HILL175_ORIGIN_KEY=/etc/hill175/tls/origin.key
HILL175_AOP_CA=/etc/hill175/tls/aop-ca.pem
HILL175_BEDROCK_ENABLED=true
HILL175_BEDROCK_PORT=19132
