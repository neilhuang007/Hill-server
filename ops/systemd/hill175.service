[Unit]
Description=Hill School 175th Anniversary Minecraft Competition
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hill175
Group=hill175
WorkingDirectory=/opt/hill175
EnvironmentFile=/etc/hill175/hill175.env
ExecStart=/opt/java25/bin/java -Xms4G -Xmx8G -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -jar /opt/hill175/paper.jar nogui
ExecStop=/bin/kill -SIGINT $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
LimitNOFILE=65535
UMask=0027

[Install]
WantedBy=multi-user.target
