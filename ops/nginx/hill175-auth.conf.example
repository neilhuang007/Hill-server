# Replace auth.example.org and certificate paths. Include inside nginx's http context.
# Firewall TCP 443 to Cloudflare's current IPv4/IPv6 ranges; keep public TCP 80 closed.
# Configure Full (strict), enable Authenticated Origin Pulls in Cloudflare, and
# bypass caching for this hostname. Prefer a zone/hostname-specific AOP certificate.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name auth.example.org;

    ssl_certificate /etc/nginx/certs/hill175-origin.pem;
    ssl_certificate_key /etc/nginx/certs/hill175-origin.key;
    ssl_client_certificate /etc/nginx/certs/hill175-aop-ca.pem;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Do not record tickets, authorization codes, cookies, or query strings.
    access_log off;
    error_log /var/log/nginx/hill175-auth-error.log crit;
    client_max_body_size 1k;

    # An unknown Host must never reach the identity service.
    if ($host != auth.example.org) { return 444; }
    if ($ssl_server_name != auth.example.org) { return 444; }

    location / {
        proxy_pass http://127.0.0.1:8087;
        proxy_set_header Host auth.example.org;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 25s;
        add_header Cache-Control "no-store" always;
    }
}
